    <circle id="drone_node_8" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="4.5" fill="#969696" stroke="#CDCDCD" stroke-width="1"/>
    <circle id="drone_node_9" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="4.5" fill="#969696" stroke="#CDCDCD" stroke-width="1"/>
    <circle id="drone_node_10" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="4.5" fill="#969696" stroke="#CDCDCD" stroke-width="1"/>
    <circle id="drone_node_11" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="4.5" fill="#969696" stroke="#CDCDCD" stroke-width="1"/>
    <path id="drone_node_14" transform="matrix(1 0 0 1 640 120)" d="M-23,-12 L-19,-16 L19,-16 L23,-12 L23,12 L19,16 L-19,16 L-23,12 Z" fill="#323232" stroke="#969696" stroke-width="1"/>
    <path id="drone_node_15" transform="matrix(1 0 0 1 640 120)" d="M-13,-10 L13,-10 L13,2 L-13,2 Z" fill="#646464" stroke="none"/>
    <circle id="drone_node_16" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="2.5" fill="#4B4B4B" stroke="#4B4B4B" stroke-width="1"/>
    <!-- The header bar's eight steps, behind the page being edited. -->
    <path id="drone_node_24" transform="matrix(1 0 0 1 0 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#000000" stroke="#000000" stroke-width="0.5"/>
    <path id="drone_node_25" transform="matrix(1 0 0 1 60 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#323232" stroke="#323232" stroke-width="0.5"/>
    <path id="drone_node_26" transform="matrix(1 0 0 1 120 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#4B4B4B" stroke="#4B4B4B" stroke-width="0.5"/>
    <path id="drone_node_27" transform="matrix(1 0 0 1 180 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#646464" stroke="#646464" stroke-width="0.5"/>
    <path id="drone_node_28" transform="matrix(1 0 0 1 240 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#7D7D7D" stroke="#7D7D7D" stroke-width="0.5"/>
    <path id="drone_node_29" transform="matrix(1 0 0 1 300 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#969696" stroke="#969696" stroke-width="0.5"/>
    <path id="drone_node_30" transform="matrix(1 0 0 1 360 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#AFAFAF" stroke="#AFAFAF" stroke-width="0.5"/>
    <path id="drone_node_31" transform="matrix(1 0 0 1 420 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#CDCDCD" stroke="#CDCDCD" stroke-width="0.5"/>
    <!-- The page being edited in the bar's colours, its titles then its values; then the other page in grey. -->
    <text id="drone_text_0" transform="matrix(1 0 0 1 5 10)" fill="#CBCBCB" font-family="UniversNextPro-Light" font-size="10px">spread</text>
    <text id="drone_text_1" transform="matrix(1 0 0 1 125 10)" fill="#CBCBCB" font-family="UniversNextPro-Light" font-size="10px">tone</text>
    <text id="drone_text_2" transform="matrix(1 0 0 1 245 10)" fill="#000000" font-family="UniversNextPro-Light" font-size="10px">motion</text>
    <text id="drone_text_3" transform="matrix(1 0 0 1 365 10)" fill="#000000" font-family="UniversNextPro-Light" font-size="10px">sub</text>
    <text id="drone_text_4" transform="matrix(1 0 0 1 65 17.4)" fill="#CBCBCB" font-family="UniversNextPro-Light" font-size="20px">40</text>
    <text id="drone_text_5" transform="matrix(1 0 0 1 185 17.4)" fill="#CBCBCB" font-family="UniversNextPro-Light" font-size="20px">45</text>
    <text id="drone_text_6" transform="matrix(1 0 0 1 305 17.4)" fill="#000000" font-family="UniversNextPro-Light" font-size="20px">40</text>
    <text id="drone_text_7" transform="matrix(1 0 0 1 425 17.4)" fill="#000000" font-family="UniversNextPro-Light" font-size="20px">50</text>
    <text id="drone_text_8" transform="matrix(1 0 0 1 5 33)" fill="#5A5A5A" font-family="UniversNextPro-Light" font-size="10px">spread</text>
    <text id="drone_text_9" transform="matrix(1 0 0 1 125 33)" fill="#5A5A5A" font-family="UniversNextPro-Light" font-size="10px">reso</text>
    <text id="drone_text_10" transform="matrix(1 0 0 1 245 33)" fill="#5A5A5A" font-family="UniversNextPro-Light" font-size="10px">rate</text>
    <text id="drone_text_11" transform="matrix(1 0 0 1 365 33)" fill="#5A5A5A" font-family="UniversNextPro-Light" font-size="10px">fifth</text>
    <text id="drone_text_12" transform="matrix(1 0 0 1 65 33)" fill="#707070" font-family="UniversNextPro-Light" font-size="13px">40</text>
    <text id="drone_text_13" transform="matrix(1 0 0 1 185 33)" fill="#707070" font-family="UniversNextPro-Light" font-size="13px">30</text>
    <text id="drone_text_14" transform="matrix(1 0 0 1 305 33)" fill="#707070" font-family="UniversNextPro-Light" font-size="13px">35</text>
    <text id="drone_text_15" transform="matrix(1 0 0 1 425 33)" fill="#707070" font-family="UniversNextPro-Light" font-size="13px">0</text>
    <!-- Palette donors: the stock grey steps, offscreen. -->
    <circle id="drone_palette_0" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="1" fill="#000000" stroke="#000000" stroke-width="1"/>
    <circle id="drone_palette_1" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="1" fill="#191919" stroke="#191919" stroke-width="1"/>
    <circle id="drone_palette_2" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="1" fill="#323232" stroke="#323232" stroke-width="1"/>
    <circle id="drone_palette_3" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="1" fill="#4B4B4B" stroke="#4B4B4B" stroke-width="1"/>
    <circle id="drone_palette_4" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="1" fill="#646464" stroke="#646464" stroke-width="1"/>
    <circle id="drone_palette_5" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="1" fill="#7D7D7D" stroke="#7D7D7D" stroke-width="1"/>
    <circle id="drone_palette_6" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="1" fill="#969696" stroke="#969696" stroke-width="1"/>
    <circle id="drone_palette_7" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="1" fill="#AFAFAF" stroke="#AFAFAF" stroke-width="1"/>
    <circle id="drone_palette_8" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="1" fill="#CDCDCD" stroke="#CDCDCD" stroke-width="1"/>
</g>
