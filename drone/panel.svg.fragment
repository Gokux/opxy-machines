<g id="drone_panel">
    <!-- Black from the top: it covers the stock header, which this machine draws itself. -->
    <rect x="0" y="0" width="480" height="220" fill="#000000"/>
    <!-- Ground shadow first: rotor discs, arms and body in the darkest grey. -->
    <circle id="drone_node_17" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="30" fill="#191919" stroke="none"/>
    <circle id="drone_node_18" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="30" fill="#191919" stroke="none"/>
    <circle id="drone_node_19" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="30" fill="#191919" stroke="none"/>
    <circle id="drone_node_20" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="30" fill="#191919" stroke="none"/>
    <path id="drone_node_21" transform="matrix(1 0 0 1 640 120)" d="M-64,-44 L64,44" fill="none" stroke="#191919" stroke-width="5"/>
    <path id="drone_node_22" transform="matrix(1 0 0 1 640 120)" d="M64,-44 L-64,44" fill="none" stroke="#191919" stroke-width="5"/>
    <path id="drone_node_23" transform="matrix(1 0 0 1 640 120)" d="M-23,-12 L-19,-16 L19,-16 L23,-12 L23,12 L19,16 L-19,16 L-23,12 Z" fill="#191919" stroke="none"/>
    <!-- Airframe: arms, rotor guards, then blades over them. -->
    <path id="drone_node_12" transform="matrix(1 0 0 1 640 120)" d="M-64,-44 L64,44" fill="none" stroke="#4B4B4B" stroke-width="5"/>
    <path id="drone_node_13" transform="matrix(1 0 0 1 640 120)" d="M64,-44 L-64,44" fill="none" stroke="#4B4B4B" stroke-width="5"/>
    <circle id="drone_node_4" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="30" fill="none" stroke="#323232" stroke-width="1"/>
    <circle id="drone_node_5" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="30" fill="none" stroke="#323232" stroke-width="1"/>
    <circle id="drone_node_6" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="30" fill="none" stroke="#323232" stroke-width="1"/>
    <circle id="drone_node_7" transform="matrix(1 0 0 1 640 120)" cx="0" cy="0" r="30" fill="none" stroke="#323232" stroke-width="1"/>
