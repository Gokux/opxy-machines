<g id="solar_panel">
    <!-- Black from the top: it covers the stock header, which this machine draws itself. -->
    <rect x="0" y="0" width="480" height="220" fill="#000000"/>
    <!-- The header bar's eight steps, behind the page being edited. -->
    <path id="solar_node_86" transform="matrix(1 0 0 1 0 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#000000" stroke="#000000" stroke-width="0.5"/>
    <path id="solar_node_87" transform="matrix(1 0 0 1 60 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#323232" stroke="#323232" stroke-width="0.5"/>
    <path id="solar_node_88" transform="matrix(1 0 0 1 120 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#4B4B4B" stroke="#4B4B4B" stroke-width="0.5"/>
    <path id="solar_node_89" transform="matrix(1 0 0 1 180 0)" d="M0,0 L60,0 L60,20 L0,20 Z" fill="#646464" stroke="#646464" stroke-width="0.5"/>
